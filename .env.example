# ==============================================================================
# RAYANXWEB CORE CONSOLE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

VITE_API_URL=https://api.yourdomain.com/v1
VITE_SOCKET_URL=wss://api.yourdomain.com

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

VITE_CHART_THROTTLE_MS=2000
VITE_TERMINAL_MAX_HISTORY_LINES=200
VITE_LOCAL_DECRYPTION_AES_KEY_BASE64=BASE64_DECRYPTION_KEY_TEMPLATE_HERE
VITE_ENABLE_VERBOSE_SIEM_LOGS=false
VITE_CONSOLE_VERSION=v1.0.0-dev
